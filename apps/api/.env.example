# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://admin:devpassword@localhost:27017/avatar_frame?authSource=admin

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin Seed (used to create the initial admin on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# File Storage (local for dev; set to 's3' for production)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# AWS S3 (only needed when STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
# AWS_S3_BASE_URL=
